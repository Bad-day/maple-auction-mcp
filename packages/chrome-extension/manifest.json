{
  "manifest_version": 3,
  "name": "Maple Auction MCP Bridge (메이플 옥션 MCP 브릿지)",
  "version": "1.0.0",
  "description": "메이플스토리 공식 웹 옥션(auction.maplestory.nexon.com)과 로컬 AI MCP 서버를 안전하게 연결하는 읽기/찜 전용 브릿지 확장 프로그램",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://auction.maplestory.nexon.com/*",
    "http://127.0.0.1:19595/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://auction.maplestory.nexon.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://auction.maplestory.nexon.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Maple Auction MCP Bridge"
  }
}
